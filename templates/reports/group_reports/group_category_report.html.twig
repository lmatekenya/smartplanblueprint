{# templates/transactions/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Transactions - PrepaidPlus{% endblock %}

{% block header_title %}Group Sales By Category{% endblock %}

{% block breadcrumb %}
    <div class="breadcrumb-item">
        <a href="{{ path('app_reports') }}" style="color: #7f8c8d;" class="breadcrumb-link">Reports</a>
        <span class="breadcrumb-separator"> / </span>
        <a href="{{ path('group_category_report') }}" style="color: #7f8c8d;" class="breadcrumb-link">Group-Category-Report</a>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-light: #3a5169;
            --secondary-light: rgba(138, 173, 194, 0.98);
            --success-light: #4caf50;
            --danger-light: #f44336;
            --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --card-hover-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
        }

        .dashboard-card {
            background: white;
            border-radius: 12px;
            box-shadow: var(--card-shadow);
            padding: 24px;
            transition: all 0.3s ease;
        }

        .dashboard-card:hover {
            box-shadow: var(--card-hover-shadow);
        }

        .transactions-summary {
            display: flex;
            gap: 20px;
            margin-bottom: 28px;
        }

        .summary-card {
            flex: 1;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            border-radius: 10px;
            padding: 20px;
            color: white;
            text-align: center;
            box-shadow: var(--card-shadow);
            transition: transform 0.3s ease;
        }

        .summary-card:hover {
            transform: translateY(-3px);
        }

        .summary-card:nth-child(2) {
            background: linear-gradient(135deg, var(--danger) 0%, var(--danger-light) 100%);
        }

        .summary-card h3 {
            margin: 0 0 8px 0;
            font-size: 0.95rem;
            font-weight: 500;
            opacity: 0.9;
        }

        .summary-value {
            font-size: 1.5rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .transactions-filters {
            background: white;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
            padding: 20px;
            margin-bottom: 24px;
        }

        .filter-row {
            display: flex;
            gap: 20px;
            margin-bottom: 16px;
        }

        .filter-group {
            flex: 1;
            min-width: 220px;
            padding: 10px;
            max-width: 730px;
        }

        .filter-group label {
            display: block;
            margin-bottom: 8px;
            color: var(--dark);
            font-weight: 500;
            font-size: 0.9rem;
        }

        .filter-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            background-color: #f9f9f9;
        }

        .filter-group input:focus {
            border-color: var(--secondary);
            box-shadow: 0 0 0 3px rgba(121, 151, 170, 0.2);
            background-color: white;
            outline: none;
        }

        .filter-actions {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }

        .btn-filter, .btn-clear {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-filter {
            background: linear-gradient(to right, var(--secondary), var(--secondary-light));
            color: white;
        }

        .btn-filter:hover {
            background: linear-gradient(to right, var(--primary), var(--primary-light));
            transform: translateY(-1px);
        }

        .btn-clear {
            background-color: white;
            color: var(--dark);
            border: 1px solid #e0e0e0;
        }

        .btn-clear:hover {
            background-color: #f5f5f5;
            border-color: #d0d0d0;
        }

        .transactions-table-container {
            overflow-x: auto;
            border-radius: 10px;
            box-shadow: var(--card-shadow);
        }

        .transactions-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background-color: white;
            font-size: 0.9rem;
        }

        .transactions-table th {
            background: linear-gradient(to right, var(--primary), var(--primary-light));
            color: white;
            padding: 14px 16px;
            text-align: left;
            font-weight: 500;
            position: sticky;
            top: 0;
        }

        .transactions-table th:first-child {
            border-top-left-radius: 10px;
        }

        .transactions-table th:last-child {
            border-top-right-radius: 10px;
        }

        .transactions-table td {
            padding: 12px 16px;
            border-bottom: 1px solid #f0f0f0;
        }

        .transactions-table tr:last-child td {
            border-bottom: none;
        }

        .transactions-table tr:hover td {
            background-color: #f8fafb;
        }

        .status-indicator {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: capitalize;
        }

        .status-success {
            background-color: rgba(76, 175, 80, 0.1);
            color: var(--success);
        }

        .status-failed {
            background-color: rgba(244, 67, 54, 0.1);
            color: var(--danger);
        }

        .status-pending {
            background-color: rgba(255, 193, 7, 0.1);
            color: var(--warning);
        }

        .status-processing {
            background-color: rgba(33, 150, 243, 0.1);
            color: #2196f3;
        }

        .status-refunded {
            background-color: rgba(156, 39, 176, 0.1);
            color: #9c27b0;
        }

        .status-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 6px;
        }

        .no-results {
            text-align: center;
            color: var(--gray);
            padding: 40px;
            font-size: 1rem;
        }

        @media (max-width: 768px) {
            .transactions-summary {
                flex-direction: column;
                gap: 16px;
            }

            .filter-row {
                flex-direction: column;
                gap: 16px;
            }

            .filter-group {
                width: 100%;
            }

            .filter-actions {
                width: 100%;
                justify-content: stretch;
            }

            .btn-filter, .btn-clear {
                flex: 1;
                justify-content: center;
            }
        }

        .btn-view {
            background: #7f8c8d;
            border-radius: 4px;
            color: rgba(227, 226, 228, 0.98);
            cursor: pointer;
            padding: 4px 8px;
            border: none;
            font-size: 0.8rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .btn-view:hover {
            background: var(--secondary-light);
        }
    </style>
{% endblock %}

{% block body %}
    <div class="dashboard-card">

        <div class="transactions-filters">
            <form method="get" action="{{ path('group_category_report') }}">
                <div class="filter-row">
                    <div class="filter-group">
                        <label for="date"><i class="fas fa-calendar-alt"></i> Filter by Date</label>
                        <input type="date" id="date" name="date" value="{{ dateFilter }}">
                    </div>

                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-filter">
                        <i class="fas fa-filter"></i> Apply Filters
                    </button>
                    <a href="{{ path('group_category_report') }}" class="btn-clear">
                        <i class="fas fa-times"></i> Clear
                    </a>
                </div>
            </form>
        </div>

        <div class="transactions-table-container">
            <table class="transactions-table">
                <thead>
                <tr>
                    <th>Category</th>
                    <th>Provider</th>
                    <th>Sale-Value</th>
                </tr>
                </thead>
                <tbody>
                {% for txn in transactions %}
                    <tr>
                        <td>{{ txn.category }}</td>
                        <td>{{ txn.provider }}</td>
                        <td>P{{ txn.sale_value|number_format(2, '.', ',') }}</td>
                    </tr>
                {% else %}

                    <tr>
                        <td colspan="6" class="no-results">
                            <i class="fas fa-info-circle" style="margin-right: 8px;"></i>
                            No transactions found matching your criteria
                        </td>
                    </tr>
                {% endfor %}
                <td style="font-weight: bold">Total</td>
                <td></td>
                <td style="font-weight: bold">P{{ total|number_format(2, '.', ',') }}</td>
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Set today's date as default if no date filter is applied
            const dateInput = document.getElementById('date');
            if (dateInput && !dateInput.value) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.value = today;
            }

            // Add subtle animation to summary cards
            const summaryCards = document.querySelectorAll('.summary-card');
            summaryCards.forEach((card, index) => {
                card.style.transitionDelay = `${index * 0.1}s`;
            });

            // Add status tooltips
            document.querySelectorAll('.status-badge').forEach(badge => {
                badge.title = `Transaction is ${badge.textContent.trim()}`;
            });
        });
    </script>
{% endblock %}
