{# templates/header_icons/profile/view.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}My Profile - PrepaidPlus{% endblock %}

{% block header_title %}My Profile{% endblock %}
{% block breadcrumb %}Profile / View{% endblock %}

{% block body %}
    <div class="dashboard-card">
        <h2>User Profile</h2>

        <div class="profile-view">
            <div class="profile-header">
                <div class="avatar-large">
                    <i class="fas fa-user-circle fa-5x"></i>
                </div>
                <div class="profile-details">
                    <h3>{{ user.firstName }} {{ user.lastName }}</h3>
                    <p class="user-email">{{ user.email }}</p>
                    <p class="user-role">Role: {{ user.roles[0]|replace({'ROLE_': ''})|lower|capitalize }}</p>

{#                    <p class="member-since">Member since {{ user.dateCreated ? user.dateCreated|date('F Y') : 'now'|date('F Y') }}</p>#}
                </div>
            </div>

            <div class="profile-stats">
                <div class="stat-card">
                    <h4>Merchants Managed</h4>
                    <p class="stat-number">{{ user.merchant ? 1 : 0 }}</p>
                </div>

                <div class="stat-card">
                    <h4>Account Status</h4>
                    <p class="stat-status {{ user.enabled ? 'active' : 'inactive' }}">
                        {{ user.enabled ? 'Active' : 'Inactive' }}
                    </p>
                </div>
            </div>

            <div class="profile-actions">
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                    <i class="fas fa-edit"></i> Edit Profile
                </a>
                <a href="{{ path('app_settings_security') }}" class="btn btn-secondary">
                    <i class="fas fa-lock"></i> Security Settings
                </a>
            </div>
        </div>
    </div>
{% endblock %}
