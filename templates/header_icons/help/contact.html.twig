{# templates/header_icons/help/contact.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Contact Support - PrepaidPlus{% endblock %}

{% block header_title %}Contact Support{% endblock %}
{% block breadcrumb %}Help / Contact Support{% endblock %}

{% block body %}
    <div class="dashboard-card">
        <h2>Contact Support</h2>
        <p>Our support team is here to help you with any questions or issues you may have.</p>

        <div class="contact-methods">
            <div class="contact-method">
                <h3><i class="fas fa-envelope"></i> Email Support</h3>
                <p>support@prepaidplus.com</p>
                <p>We typically respond within 24 hours.</p>
            </div>

            <div class="contact-method">
                <h3><i class="fas fa-phone"></i> Phone Support</h3>
                <p>1-800-PREPAID (1-800-773-7243)</p>
                <p>Monday - Friday, 9 AM - 6 PM EST</p>
            </div>

            <div class="contact-method">
                <h3><i class="fas fa-comments"></i> Live Chat</h3>
                <p>Available during business hours</p>
                <p>Look for the chat icon in the bottom right corner of your screen.</p>
            </div>
        </div>
    </div>
{% endblock %}
