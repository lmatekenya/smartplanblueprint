{# templates/header_icons/settings/security.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Security Settings - PrepaidPlus{% endblock %}

{% block header_title %}Security Settings{% endblock %}
{% block breadcrumb %}Settings / Security{% endblock %}

{% block body %}
    <div class="dashboard-card">
        <h2>Security Settings</h2>

        <div class="security-sections">
            <div class="security-section">
                <h3>Change Password</h3>
                {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.currentPassword) }}
                    {{ form_widget(form.currentPassword) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.newPassword.first) }}
                    {{ form_widget(form.newPassword.first) }}
                </div>

                <div class="form-group">
                    {{ form_label(form.newPassword.second) }}
                    {{ form_widget(form.newPassword.second) }}
                </div>

                {{ form_widget(form.save) }}
                {{ form_end(form) }}
            </div>

            <div class="security-section">
                <h3>Two-Factor Authentication</h3>
                <div class="2fa-status">
                    <p>Status: <span class="status-disabled">Disabled</span></p>
                    <button class="btn btn-secondary">Enable 2FA</button>
                </div>
            </div>

            <div class="security-section">
                <h3>Active Sessions</h3>
                <div class="sessions-list">
                    <div class="session-item">
                        <div class="session-info">
                            <strong>Current Session</strong>
                            <p>Chrome on Windows • {{ 'now'|date('M j, Y g:i A') }}</p>
                            <p>IP: 192.168.1.1 • Location: New York, US</p>
                        </div>
                    </div>

                    <div class="session-item">
                        <div class="session-info">
                            <strong>Previous Session</strong>
                            <p>Safari on macOS • {{ 'now'|date('M j, Y g:i A') }}</p>
                            <p>IP: 192.168.1.2 • Location: New York, US</p>
                        </div>
                        <button class="btn btn-sm btn-danger">Revoke</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
